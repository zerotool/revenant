#!/bin/bash
# Prints the UUID of the Ghostty surface whose pty is $1. Ghostty saves that UUID with the window
# state and gives it back to the restored surface, so it names a tab across restarts.
# $2 = attempts, 0.1s apart: a surface that is being restored runs its command before AppleScript
# can see it.
tty=$1
tries=${2:-1}
for ((i = 0; i < tries; i++)); do
  id=$(osascript \
    -e 'on run argv' \
    -e 'with timeout of 3 seconds' \
    -e 'tell application id "com.mitchellh.ghostty" to return id of (first terminal whose tty is (item 1 of argv))' \
    -e 'end timeout' \
    -e 'end run' \
    "$tty" 2>/dev/null)
  [[ -n $id ]] && { echo "$id"; exit 0; }
  sleep 0.1
done
exit 1
